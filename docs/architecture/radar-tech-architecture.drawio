        <mxCell id="n1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#3c4654;lineHeight=1.5;" value="&lt;b&gt;两条主流程&lt;/b&gt;&lt;br&gt;&lt;b&gt;① 配置流&lt;/b&gt;（左→右）：admin 改配置 → 写 MySQL → 发 Redis 频道 → 引擎收到热更新，&lt;b&gt;不用重启&lt;/b&gt;&lt;br&gt;&lt;b&gt;② 调用流&lt;/b&gt;：业务方事件 → 引擎落 Mongo → 抽象算滑窗值 → 规则打分 → 策略定级 → 返回 + 结果缓存 5 分钟" vertex="1">
          <mxGeometry height="72" width="680" x="980" y="12" as="geometry" />
        </mxCell>
        <mxCell id="lane2" parent="1" style="swimlane;startSize=46;html=1;horizontal=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2d3d;fontSize=15;fontStyle=1;rounded=0;pointerEvents=0;" value="接入层" vertex="1">
